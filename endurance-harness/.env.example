# 复制为 .env.local 并填写；此文件不含真实凭据。
# shell 中依次执行 set -a / source .env.local / set +a 后运行 Java/Maven。
ENDURANCE_PORT=8080
ENDURANCE_POSTGRES_ENABLED=false
ENDURANCE_DB_URL=jdbc:postgresql://127.0.0.1:5432/endurance
ENDURANCE_DB_USERNAME=
ENDURANCE_DB_PASSWORD=
ENDURANCE_DB_SCHEMA=endurance
ENDURANCE_REDIS_ENABLED=false
ENDURANCE_REDIS_HOST=127.0.0.1
ENDURANCE_REDIS_PORT=6379
ENDURANCE_REDIS_DATABASE=0
ENDURANCE_REDIS_USERNAME=
ENDURANCE_REDIS_PASSWORD=
ENDURANCE_REDIS_SSL=false
# 有独立观测接收器时再启用。
ENDURANCE_OTLP_TRACES_ENABLED=false
ENDURANCE_OTLP_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://127.0.0.1:4318/v1/metrics
# 服务访问凭据：启用时要求 32~256 字符，不生成默认账号。
ENDURANCE_AUTH_ENABLED=false
ENDURANCE_API_TOKEN=
