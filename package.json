{
  "name": "endurance",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @endurance/web dev",
    "dev:admin": "pnpm --filter @endurance/admin dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint endurance-web/src endurance-admin/src --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0"
  },
  "type": "module"
}
